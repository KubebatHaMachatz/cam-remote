<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The agent opens one port on the local network and serves commands on it. It never dials
         out, and it no longer advertises itself: the operator reads the address off the agent's
         own notification. See docs/DEVICES.md for why discovery was removed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To notice the device's own address changing, so the notification (the only place an
         operator can read it) does not go stale when DHCP moves the handset. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Needed so a background service may start the camera app at all, and as the documented
         exemption from the API 34+ rule against starting a camera-type foreground service from
         the background. Requested from LaunchActivity, the first time the app is opened. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      API 30+ package visibility: without this, resolveActivity cannot see the camera app and
      camera.open would report "no camera app installed" on every modern device.

      One entry per strategy in CameraAppLaunch. A missing entry here does not fail loudly - the
      candidate simply never resolves - so the two lists have to be kept in step.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!--
          The app's only screen, and it draws nothing of its own: the translucent theme means the
          only thing a user ever sees launching this is a native Android dialog (see
          LaunchActivity's own doc comment). It is still the LAUNCHER, because Android gives no other
          way to start an app for the first time; every later start is on demand, from a command
          that needs a permission the device does not have yet.
        -->
        <activity
            android:name=".setup.LaunchActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          camera:      required from API 34 to touch the camera from a service.
          specialUse:  the agent is a long-lived local-network server, which is not any of the
                       predefined types. dataSync would fit less well and carries a daily runtime
                       cap that would stop the agent after six hours.
        -->
        <service
            android:name=".service.RemoteControlService"
            android:exported="false"
            android:foregroundServiceType="camera|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Remotely controlled camera agent serving a local-network command API" />
        </service>


        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
